    "criar_memoria_vazia",
    "limpar_memoria",
    "normalizar_memoria",
    "registrar_comparacao",
    "registrar_concorrente",
    "registrar_fluxo",
    "registrar_oferta",
    "registrar_produto",
    "resumir_memoria_para_modelo",
    "registrar_analise_reposicao",
]